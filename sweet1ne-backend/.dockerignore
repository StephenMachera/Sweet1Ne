# Ignore files and directories that should not be included in the Docker image

.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

.git/
.gitignore

# Let's Encrypt data for the nginx/certbot containers — mounted as volumes,
# never needed inside the api image, and some files are root-owned so
# including them can break the build for a non-root deploy user.
certbot/

.env
.env.*
!.env.example

tests/
pytest.ini

*.md
.vscode/
.idea/